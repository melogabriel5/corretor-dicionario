{
  "manifest_version": 3,
  "name": "Corretor Local por Dicionário",
  "version": "2.2",
  "description": "Correção automática, motor morfológico, expansão de atalhos e sugestões locais em tempo real.",
  "permissions": ["storage", "activeTab"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Configurar Corretor",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["morphology.js", "dictionary.js", "content.js"],
      "css": ["styles.css"],
      "all_frames": true
    }
  ]
}
